{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",

  "name": "blog",
  "compatibility_date": "2026-10-01",

  "main": "worker/404.ts",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/404", "/404.html"],
    "not_found_handling": "404-page",
  },

  "cache": {
    "enabled": true,
  },

  "observability": {
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },

  "previews": {},
}
